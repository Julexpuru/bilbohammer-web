# SEO / robots
SEO_ROBOTS_BLOCKED_BOTS=GPTBot,ClaudeBot,anthropic-ai,CCBot,Bytespider,Diffbot,Meta-ExternalAgent,PerplexityBot,Perplexity-User
SEO_ROBOTS_THROTTLED_BOTS=
SEO_ROBOTS_CRAWL_DELAY_SECONDS=

# Mitigacion de trafico automatizado (middleware)
BOT_BLOCKED_USER_AGENTS=GPTBot,ClaudeBot,anthropic-ai,CCBot,Bytespider,Diffbot,PerplexityBot,Perplexity-User
BOT_TRUSTED_INDEXER_USER_AGENTS=Googlebot,Bingbot,DuckDuckBot,Applebot
BOT_RATE_LIMIT_ENABLED=true
BOT_RATE_LIMIT_WINDOW_SECONDS=60
BOT_RATE_LIMIT_MAX_REQUESTS=180
BOT_RATE_LIMIT_PATH_PREFIXES=/
BOT_RATE_LIMIT_EXEMPT_PATHS=/robots.txt,/sitemap.xml
