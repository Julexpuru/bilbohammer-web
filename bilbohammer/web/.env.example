APP_BASE_URL=http://localhost:3000
VAPID_PUBLIC_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:no-reply@bilbohammer.es
NOTIFICATIONS_CRON_SECRET=
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DEV_ONLY_PATHS=/juego-organizado,/sobre-nosotros,/sobre-nosotros/quienes-somos
DEV_ONLY_BYPASS_TOKEN=
STORAGE_BUCKET=bilbohammer-uploads
STORAGE_REGION=auto
STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
