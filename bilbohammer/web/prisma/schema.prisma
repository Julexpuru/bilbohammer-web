model GalleryAlbum {
  id             String   @id @default(cuid())
  slug           String   @unique
  title          String
  description    String?
  location       String?
  displayDate    String?
  dateISO        String?
  coverImagePath String?
  coverImageAlt  String?
  totalPhotos    Int      @default(0)
  facetYear      String
  facetGame      String
  facetFormat    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tags           GalleryAlbumTag[]
  collaborators  GalleryAlbumCollaborator[]
  images         GalleryImage[]
  event          Event?    @relation("EventAlbum")
}

model GalleryImage {
  id            String      @id @default(cuid())
  albumId       String?
  uploaderId    Int?
  storagePath   String
  thumbnailPath String?
  title         String?
  altText       String?
  description   String?
  takenAt       DateTime?
  location      String?
  width         Int?
  height        Int?
  fileSize      Int?
  mimeType      String?
  position      Int?
  likesCount    Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  album    GalleryAlbum?             @relation(fields: [albumId], references: [id], onDelete: SetNull)
  uploader User?                     @relation(fields: [uploaderId], references: [id], onDelete: SetNull)
  eventId String?
  event   Event?                     @relation(fields: [eventId], references: [id], onDelete: SetNull)
}

model GalleryAlbumTag {
  id        String        @id @default(cuid())
  albumId   String
  label     String
  createdAt DateTime      @default(now())

  album GalleryAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade)

  @@unique([albumId, label])
}

model GalleryAlbumCollaborator {
  id        String        @id @default(cuid())
  albumId   String
  userId    Int
  role      String?
  createdAt DateTime      @default(now())

  album GalleryAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade)
  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([albumId, userId])
}

model Organization {
  id        String                 @id @default(cuid())
  slug      String                 @unique
  name      String
  isClub    Boolean                @default(false)
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  events    EventOrganization[]
}

model EventOrganization {
  id             String        @id @default(cuid())
  eventId        String
  organizationId String
  role           String?
  createdAt      DateTime      @default(now())

  event        Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([eventId, organizationId])
}

model EventOrganizer {
  id        String   @id @default(cuid())
  eventId   String
  userId    Int
  role      String?
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}

model EventTag {
  id        String   @id @default(cuid())
  eventId   String
  label     String
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, label])
}

model EventAttachment {
  id          String   @id @default(cuid())
  eventId     String
  title       String
  description String?
  fileUrl     String
  visible     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model EventLink {
  id        String   @id @default(cuid())
  eventId   String
  label     String
  url       String
  visible   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model EventHighlight {
  id         String             @id @default(cuid())
  eventId    String
  type       EventHighlightType
  title      String
  playerName String
  playerId   Int?
  visible    Boolean            @default(true)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  event  Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  player User? @relation("EventHighlightPlayer", fields: [playerId], references: [id], onDelete: SetNull)
}

model EventRankingEntry {
  id         String   @id @default(cuid())
  eventId    String
  position   Int
  playerName String
  playerId   Int?
  score      String?
  visible    Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  event  Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  player User? @relation("EventRankingPlayer", fields: [playerId], references: [id], onDelete: SetNull)

  @@unique([eventId, position])
}

model GameInfo {
  id             String   @id @default(cuid())
  game           Juego    @unique
  summary        String   @db.Text
  contentHtml    String   @db.Text
  investment     String   @default("")
  playtime       String   @default("")
  learning       String   @default("Media")
  contactUserId  Int?
  contactNote    String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  contactUser User? @relation(fields: [contactUserId], references: [id], onDelete: SetNull)
}


