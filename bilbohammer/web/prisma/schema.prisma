// Prisma schema adaptada para NextAuth v5 + tus enums/campos.
// Nota: IDs de usuario son Int autoincrement(), por lo que Account/Session usan userId Int.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // ajusta si usas otro
  url      = env("DATABASE_URL")
}

// ===== Enums propios =====
enum Rol {
  ADMIN
  JUNTA
  REDACTOR
  SOCIO
  AMIGO
}

enum PostType {
  ANUNCIO
  EVENTO
  NOTICIA_PRIVADA
}

enum EventStatus {
  DRAFT
  PUBLISHED
  PREPARATION
  IN_PROGRESS
  FINALIZED
  POSTPONED
  CANCELLED
}

enum EventType {
  SOCIAL
  TOURNAMENT
  LEAGUE
  WORKSHOP
  OTHER
}

enum EventHighlightType {
  FIRST
  SECOND
  THIRD
  AWARD
}

enum TableStatus {
  AVAILABLE
  RESERVED
  IN_PLAY
  BLOCKED
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  IN_PLAY
  ENDED
  CANCELLED
}

enum MatchStatus {
  PENDING
  CONFIRMED
  IN_PLAY
  DONE
  CANCELLED
}

enum SlotStatus {
  OPEN
  MATCHED
  CANCELLED
}

enum SlotProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

enum ParticipantRole {
  HOST
  GUEST
  STAFF
}

enum ParticipantStatus {
  PENDING
  CONFIRMED
  DECLINED
}

enum UserNotificationType {
  SLOT_PROPOSAL_RECEIVED
  SLOT_PROPOSAL_ACCEPTED
  SLOT_PROPOSAL_REJECTED
  SLOT_PROPOSAL_SUPERSEDED
  MATCH_REMINDER
  MATCH_CANCELLED
  COMPATIBLE_SLOT_CREATED
}

enum UserNotificationChannel {
  EMAIL
  PUSH
}

enum UserNotificationDeliveryStatus {
  SENT
  FAILED
  SKIPPED
}

enum EventRegistrationStatus {
  INSCRITO
  PAGADO
  CANCELLED
}

enum EventRegistrationSource {
  WEB
  ADMIN
  TELEGRAM
  IMPORT
}

enum CompetitiveMatchKind {
  LEAGUE
  CASUAL
}

enum CompetitiveMatchOutcome {
  WIN
  DRAW
  LOSS
}

enum CompetitiveMatchReportStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum CompetitiveMatchReportChannel {
  WEB
  TELEGRAM
  ADMIN
  IMPORT
}

model NewsArticle {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  summary         String   @db.Text
  banner          String?  @db.Text
  author          String?
  date            DateTime @default(now())
  tags            String[] @default([])
  primaryCategory String
  categories      String[] @default([])
  status          String   @default("published")
  body            Json
  comments        Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  chronicleEvents Event[]          @relation("EventPrimaryChronicle")
  eventChronicles EventChronicle[]

  @@index([primaryCategory])
  @@index([date])
}

// ===== Modelos =====
model User {
  id            Int       @id @default(autoincrement())
  // Campos esperados por NextAuth
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?

  // Login local
  passwordHash String?

  // Perfil propio
  roles           Rol[]     @default([])
  nombre          String?
  nick            String?   @unique
  descripcion     String?
  etiquetas       String[]
  avatarUrl       String?
  oauthAvatarUrl  String?
  facePhotoUrl    String?
  isActive        Boolean   @default(true)
  lastLoginAt     DateTime?
  membershipSince DateTime?
  membershipUntil DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  accounts                    Account[]
  sessions                    Session[]
  posts                       Post[]
  games                       UserGame[]
  faccionesW40K               FaccionesW40K[]
  faccionesAoS                FaccionesAoS[]
  faccionesTOW                FaccionesTOW[]
  galleryImages               GalleryImage[]
  albumCollaborations         GalleryAlbumCollaborator[]
  eventOrganizers             EventOrganizer[]
  eventHighlights             EventHighlight[]               @relation("EventHighlightPlayer")
  eventRankings               EventRankingEntry[]            @relation("EventRankingPlayer")
  coordinatedGames            GameInfo[]                     @relation("GameInfoContact")
  managedChangeLogs           UserChangeLog[]                @relation("UserChangeLogAdmin")
  receivedChangeLogs          UserChangeLog[]                @relation("UserChangeLogTarget")
  createdInvites              UserInvite[]                   @relation("UserInviteCreator")
  claimedInvites              UserInvite[]                   @relation("UserInviteTarget")
  availabilitySlots           AvailabilitySlot[]             @relation("AvailabilitySlotCreator")
  sentSlotProposals           SlotProposal[]                 @relation("SlotProposalRequester")
  recurringAvailability       RecurringAvailability[]
  matchParticipations         MatchParticipant[]
  createdMatches              Match[]                        @relation("MatchCreator")
  createdTableReservations    TableReservation[]             @relation("TableReservationCreator")
  createdTableBlocks          TableBlock[]                   @relation("TableBlockCreator")
  receivedNotifications       UserNotification[]             @relation("UserNotificationRecipient")
  actedNotifications          UserNotification[]             @relation("UserNotificationActor")
  notificationPreference      UserNotificationPreference?
  pushSubscriptions           UserPushSubscription[]
  eventRegistrations          EventRegistration[]
  reviewedRegistrations       EventRegistration[]            @relation("EventRegistrationReviewer")
  createdCompetitiveMatches   CompetitiveMatch[]             @relation("CompetitiveMatchCreator")
  validatedCompetitiveMatches CompetitiveMatch[]             @relation("CompetitiveMatchValidator")
  competitiveMatchPlayers     CompetitiveMatchPlayer[]
  submittedCompetitiveReports CompetitiveMatchReport[]       @relation("CompetitiveMatchReportSubmitter")
  reviewedCompetitiveReports  CompetitiveMatchReport[]       @relation("CompetitiveMatchReportReviewer")
  competitiveReportPlayers    CompetitiveMatchReportPlayer[]
}

model Account {
  id                Int     @id @default(autoincrement())
  userId            Int
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Game {
  id            String   @id @default(cuid())
  name          String
  description   String?
  slug          String   @unique
  legacyEnumKey String?  @unique
  iconImagePath String?
  heroImagePath String?
  isDefault     Boolean  @default(false)
  sortOrder     Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  users              UserGame[]
  events             Event[]
  info               GameInfo?
  tableLayouts       TableLayout[]
  clubTables         ClubTable[]
  availabilitySlots  AvailabilitySlot[]
  slotProposals      SlotProposal[]
  matches            Match[]
  competitiveMatches CompetitiveMatch[]
  competitiveReports CompetitiveMatchReport[]
}

model UserGame {
  userId    Int
  gameId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@id([userId, gameId])
}

model GameInfo {
  id            String   @id @default(cuid())
  gameId        String   @unique
  summary       String   @db.Text
  contentHtml   String   @db.Text
  investment    String   @default("")
  playtime      String   @default("")
  learning      String   @default("Media")
  contactUserId Int?
  contactNote   String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  game        Game  @relation(fields: [gameId], references: [id], onDelete: Cascade)
  contactUser User? @relation("GameInfoContact", fields: [contactUserId], references: [id], onDelete: SetNull)
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       Int
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model UserChangeLog {
  id         Int      @id @default(autoincrement())
  userId     Int
  adminId    Int?
  adminEmail String?
  changes    Json
  createdAt  DateTime @default(now())

  user  User  @relation("UserChangeLogTarget", fields: [userId], references: [id], onDelete: Cascade)
  admin User? @relation("UserChangeLogAdmin", fields: [adminId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId])
}

model Post {
  id            String   @id @default(cuid())
  title         String
  content       String?
  type          PostType
  published     Boolean  @default(true)
  reactionScore Int      @default(0)
  createdAt     DateTime @default(now())

  authorId Int?
  author   User? @relation(fields: [authorId], references: [id])

  eventId String?
  event   Event?  @relation(fields: [eventId], references: [id])
}

model Event {
  id                    String      @id @default(cuid())
  title                 String
  bannerUrl             String?
  startsAt              DateTime
  endsAt                DateTime
  registrationClosesAt  DateTime?
  location              String?
  latitude              Float?
  longitude             Float?
  mapsUrl               String?
  details               String?     @db.Text
  recap                 String?     @db.Text
  status                EventStatus @default(DRAFT)
  type                  EventType   @default(OTHER)
  gameId                String?
  priceGeneral          Decimal?    @db.Decimal(10, 2)
  priceSocios           Decimal?    @db.Decimal(10, 2)
  capacityMax           Int?
  capacityCurrent       Int?        @default(0)
  isInternal            Boolean     @default(false)
  isMembersOnly         Boolean     @default(false)
  showDescription       Boolean     @default(true)
  showAttachments       Boolean     @default(true)
  showLinks             Boolean     @default(true)
  showStandings         Boolean     @default(true)
  showRecap             Boolean     @default(true)
  showGallery           Boolean     @default(true)
  showLocation          Boolean     @default(true)
  showTabDescription    Boolean     @default(true)
  showTabResources      Boolean     @default(true)
  showTabClassification Boolean     @default(true)
  showTabChronicle      Boolean     @default(true)
  showTabGallery        Boolean     @default(true)
  showTabLocation       Boolean     @default(true)
  chronicleArticleId    String?
  albumId               String?     @unique
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  posts              Post[]
  organizers         EventOrganizer[]
  organizations      EventOrganization[]
  tags               EventTag[]
  attachments        EventAttachment[]
  links              EventLink[]
  highlights         EventHighlight[]
  rankings           EventRankingEntry[]
  galleryImages      GalleryImage[]
  album              GalleryAlbum?            @relation("EventAlbum", fields: [albumId], references: [id], onDelete: SetNull)
  game               Game?                    @relation(fields: [gameId], references: [id], onDelete: SetNull)
  chronicleArticle   NewsArticle?             @relation("EventPrimaryChronicle", fields: [chronicleArticleId], references: [id], onDelete: SetNull)
  chronicleLinks     EventChronicle[]
  registrations      EventRegistration[]
  matches            Match[]
  competitiveMatches CompetitiveMatch[]
  competitiveReports CompetitiveMatchReport[]
  tableBlocks        TableBlock[]
}

model Notification {
  id        String   @id @default(cuid())
  title     String
  content   String
  visible   Boolean  @default(true)
  createdAt DateTime @default(now())
}

model UserNotification {
  id              String               @id @default(cuid())
  userId          Int
  type            UserNotificationType
  title           String
  body            String               @db.Text
  linkUrl         String?
  metadata        Json?
  actorUserId     Int?
  dedupeKey       String?              @unique
  visibleInApp    Boolean              @default(true)
  readAt          DateTime?
  createdAt       DateTime             @default(now())

  user       User                       @relation("UserNotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor      User?                      @relation("UserNotificationActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  deliveries UserNotificationDelivery[]

  @@index([userId, createdAt])
  @@index([userId, visibleInApp, readAt])
}

model UserNotificationDelivery {
  id             String                         @id @default(cuid())
  notificationId String
  channel        UserNotificationChannel
  status         UserNotificationDeliveryStatus
  error          String?
  sentAt         DateTime?
  createdAt      DateTime                       @default(now())
  updatedAt      DateTime                       @updatedAt

  notification UserNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([notificationId, channel])
  @@index([channel, status])
}

model UserNotificationPreference {
  userId                  Int      @id
  proposalReceivedInApp   Boolean  @default(true)
  proposalReceivedEmail   Boolean  @default(false)
  proposalReceivedPush    Boolean  @default(true)
  proposalAcceptedInApp   Boolean  @default(true)
  proposalAcceptedEmail   Boolean  @default(false)
  proposalAcceptedPush    Boolean  @default(true)
  proposalRejectedInApp   Boolean  @default(true)
  proposalRejectedEmail   Boolean  @default(false)
  proposalRejectedPush    Boolean  @default(true)
  proposalSupersededInApp Boolean  @default(true)
  proposalSupersededEmail Boolean  @default(false)
  proposalSupersededPush  Boolean  @default(true)
  matchReminderInApp      Boolean  @default(true)
  matchReminderEmail      Boolean  @default(false)
  matchReminderPush       Boolean  @default(true)
  matchReminderMinutes    Int      @default(1440)
  matchCancelledInApp     Boolean  @default(true)
  matchCancelledEmail     Boolean  @default(false)
  matchCancelledPush      Boolean  @default(true)
  compatibleSlotInApp     Boolean  @default(true)
  compatibleSlotEmail     Boolean  @default(false)
  compatibleSlotPush      Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserPushSubscription {
  id        String    @id @default(cuid())
  userId    Int
  endpoint  String    @unique @db.Text
  p256dh    String    @db.Text
  auth      String    @db.Text
  userAgent String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
}

model ClubTable {
  id        String      @id @default(cuid())
  name      String
  posX      Int         @default(0)
  posY      Int         @default(0)
  width     Int         @default(180)
  height    Int         @default(120)
  rotation  Int         @default(0)
  sizeTag   String?
  status    TableStatus @default(AVAILABLE)
  gameId           String?
  gameLabel        String?
  layoutImagePath  String?
  sceneryImagePath String?
  isActive  Boolean     @default(true)
  notes     String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  game         Game?            @relation(fields: [gameId], references: [id], onDelete: SetNull)
  layouts      TableLayout[]
  reservations TableReservation[]
  blocks       TableBlock[]

  @@unique([name])
  @@index([gameId])
}

model TableLayout {
  id           String   @id @default(cuid())
  tableId      String
  title        String
  description  String?
  gameId       String?
  sceneryNotes String?
  isDefault    Boolean  @default(false)
  weekday      Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  table ClubTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
  game  Game?     @relation(fields: [gameId], references: [id], onDelete: SetNull)

  @@unique([tableId, title])
  @@index([tableId])
  @@index([gameId])
}

model TableBlock {
  id          String   @id @default(cuid())
  tableId     String
  start       DateTime
  end         DateTime
  reason      String?
  eventId     String?
  createdById Int?
  createdAt   DateTime @default(now())

  table     ClubTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
  event     Event?    @relation(fields: [eventId], references: [id], onDelete: SetNull)
  createdBy User?     @relation("TableBlockCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([tableId, start, end])
  @@index([eventId])
}

model TableReservation {
  id          String            @id @default(cuid())
  tableId     String
  start       DateTime
  end         DateTime
  status      ReservationStatus @default(PENDING)
  matchId     String?           @unique
  createdById Int?
  notes       String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  table     ClubTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
  match     Match?    @relation(fields: [matchId], references: [id], onDelete: SetNull)
  createdBy User?     @relation("TableReservationCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([tableId, start, end])
}

model Match {
  id          String      @id @default(cuid())
  gameId      String?
  eventId     String?
  slotId      String?     @unique
  proposalId  String?     @unique
  startsAt    DateTime
  endsAt      DateTime
  status      MatchStatus @default(PENDING)
  format      String?
  notes       String?
  roundNumber Int?
  createdById Int?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  game         Game?              @relation(fields: [gameId], references: [id], onDelete: SetNull)
  event        Event?             @relation(fields: [eventId], references: [id], onDelete: SetNull)
  slot         AvailabilitySlot?  @relation("SlotMatch", fields: [slotId], references: [id], onDelete: SetNull)
  proposal     SlotProposal?      @relation("ProposalMatch", fields: [proposalId], references: [id], onDelete: SetNull)
  createdBy    User?              @relation("MatchCreator", fields: [createdById], references: [id], onDelete: SetNull)
  participants MatchParticipant[]
  reservations TableReservation[]

  @@index([startsAt, endsAt])
  @@index([eventId])
}

model MatchParticipant {
  matchId   String
  userId    Int
  role      ParticipantRole   @default(HOST)
  status    ParticipantStatus @default(PENDING)
  note      String?
  createdAt DateTime          @default(now())

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([matchId, userId])
  @@index([userId])
}

model AvailabilitySlot {
  id        String     @id @default(cuid())
  creatorId Int
  gameId    String?
  start     DateTime
  end       DateTime
  status    SlotStatus @default(OPEN)
  level     String?
  format    String?
  note      String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  creator User   @relation("AvailabilitySlotCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  game    Game?  @relation(fields: [gameId], references: [id], onDelete: SetNull)
  match   Match? @relation("SlotMatch")
  proposals SlotProposal[]

  @@index([creatorId])
  @@index([start, end])
  @@index([gameId])
}

model SlotProposal {
  id            String             @id @default(cuid())
  slotId         String
  requesterId    Int
  gameId         String?
  proposedStart  DateTime
  proposedEnd    DateTime
  note           String?
  status         SlotProposalStatus @default(PENDING)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  slot      AvailabilitySlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  requester User             @relation("SlotProposalRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  game      Game?            @relation(fields: [gameId], references: [id], onDelete: SetNull)
  match     Match?           @relation("ProposalMatch")

  @@index([slotId, status])
  @@index([requesterId, status])
  @@index([proposedStart, proposedEnd])
}

model RecurringAvailability {
  id              String   @id @default(cuid())
  userId          Int
  weekday         Int
  startMinutes    Int
  endMinutes      Int
  preferredGames  String[] @default([])
  preferencesNote String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, weekday])
}

