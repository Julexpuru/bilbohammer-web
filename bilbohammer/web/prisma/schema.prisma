// Prisma schema adaptada para NextAuth v5 + tus enums/campos.
// Nota: IDs de usuario son Int autoincrement(), por lo que Account/Session usan userId Int.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // ajusta si usas otro
  url      = env("DATABASE_URL")
}

// ===== Enums propios =====
enum Rol {
  ADMIN
  JUNTA
  SOCIO
  AMIGO
}

enum Juego {
  W40K
  AOS
  TOW
  ESDLA
  BB
  MARVEL
  ROL
  MAGIC
  JUEGOS_DE_MESA
  OTROS
}

enum PostType {
  ANUNCIO
  EVENTO
  NOTICIA_PRIVADA
}

enum EventStatus {
  DRAFT
  PUBLISHED
  FINALIZED
  POSTPONED
  CANCELLED
}

enum EventType {
  SOCIAL
  TOURNAMENT
  LEAGUE
  WORKSHOP
  OTHER
}

enum EventHighlightType {
  FIRST
  SECOND
  THIRD
  AWARD
}

// ===== Modelos =====
model User {
  id            Int       @id @default(autoincrement())
  // Campos esperados por NextAuth
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?

  // Login local
  passwordHash String?

  // Perfil propio
  roles          Rol[]     @default([])
  nombre          String?
  nick            String?   @unique
  descripcion     String?
  juegos          Juego[]
  etiquetas       String[]
  avatarUrl       String?
  isActive        Boolean   @default(true)
  lastLoginAt     DateTime?
  membershipSince DateTime?
  membershipUntil DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  posts         Post[]
  faccionesW40K FaccionesW40K[]
  faccionesAoS  FaccionesAoS[]
  faccionesTOW  FaccionesTOW[]
  galleryImages        GalleryImage[]
  albumCollaborations  GalleryAlbumCollaborator[]
  eventOrganizers      EventOrganizer[]
  eventHighlights      EventHighlight[]     @relation("EventHighlightPlayer")
  eventRankings        EventRankingEntry[]  @relation("EventRankingPlayer")
  gameInfos            GameInfo[]
}

model Account {
  id                Int     @id @default(autoincrement())
  userId            Int
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       Int
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  type      PostType
  published Boolean  @default(true)
  createdAt DateTime @default(now())

  authorId Int?
  author   User? @relation(fields: [authorId], references: [id])

  eventId String?
  event   Event?  @relation(fields: [eventId], references: [id])
}

model Event {
  id               String          @id @default(cuid())
  title            String
  bannerUrl        String?
  startsAt         DateTime
  endsAt           DateTime
  location         String?
  latitude         Float?
  longitude        Float?
  mapsUrl          String?
  details          String?         @db.Text
  recap            String?         @db.Text
  status           EventStatus     @default(DRAFT)
  type             EventType       @default(OTHER)
  game             Juego?
  priceGeneral     Decimal?        @db.Decimal(10, 2)
  priceSocios      Decimal?        @db.Decimal(10, 2)
  capacityMax      Int?
  capacityCurrent  Int?            @default(0)
  isInternal       Boolean         @default(false)
  isMembersOnly    Boolean         @default(false)
  showDescription  Boolean         @default(true)
  showAttachments  Boolean         @default(true)
  showLinks        Boolean         @default(true)
  showStandings    Boolean         @default(true)
  showRecap        Boolean         @default(true)
  showGallery      Boolean         @default(true)
  showLocation     Boolean         @default(true)
  showTabDescription Boolean       @default(true)
  showTabResources Boolean         @default(true)
  showTabClassification Boolean    @default(true)
  showTabChronicle Boolean         @default(true)
  showTabGallery   Boolean         @default(true)
  showTabLocation  Boolean         @default(true)
  albumId          String?   @unique
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  posts            Post[]
  organizers       EventOrganizer[]
  organizations    EventOrganization[]
  tags             EventTag[]
  attachments      EventAttachment[]
  links            EventLink[]
  highlights       EventHighlight[]
  rankings         EventRankingEntry[]
  galleryImages    GalleryImage[]
  album            GalleryAlbum?   @relation("EventAlbum", fields: [albumId], references: [id], onDelete: SetNull)
}

model Notification {
  id        String   @id @default(cuid())
  title     String
  content   String
  visible   Boolean  @default(true)
  createdAt DateTime @default(now())
}

