model GalleryAlbum {
  id             String   @id @default(cuid())
  slug           String   @unique
  title          String
  description    String?
  location       String?
  displayDate    String?
  dateISO        String?
  coverImagePath String?
  coverImageAlt  String?
  totalPhotos    Int      @default(0)
  facetYear      String
  facetGame      String
  facetFormat    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tags          GalleryAlbumTag[]
  collaborators GalleryAlbumCollaborator[]
  images        GalleryImage[]
  event         Event?                     @relation("EventAlbum")
}

model GalleryImage {
  id            String    @id @default(cuid())
  albumId       String?
  uploaderId    Int?
  storagePath   String
  thumbnailPath String?
  title         String?
  altText       String?
  description   String?
  takenAt       DateTime?
  location      String?
  width         Int?
  height        Int?
  fileSize      Int?
  mimeType      String?
  position      Int?
  likesCount    Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  album    GalleryAlbum? @relation(fields: [albumId], references: [id], onDelete: SetNull)
  uploader User?         @relation(fields: [uploaderId], references: [id], onDelete: SetNull)
  eventId  String?
  event    Event?        @relation(fields: [eventId], references: [id], onDelete: SetNull)
}

model GalleryAlbumTag {
  id        String   @id @default(cuid())
  albumId   String
  label     String
  createdAt DateTime @default(now())

  album GalleryAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade)

  @@unique([albumId, label])
}

model GalleryAlbumCollaborator {
  id        String   @id @default(cuid())
  albumId   String
  userId    Int
  role      String?
  createdAt DateTime @default(now())

  album GalleryAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade)
  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([albumId, userId])
}

model Organization {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  isClub    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events EventOrganization[]
}

model EventOrganization {
  id             String   @id @default(cuid())
  eventId        String
  organizationId String
  role           String?
  createdAt      DateTime @default(now())

  event        Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([eventId, organizationId])
}

model EventOrganizer {
  id        String   @id @default(cuid())
  eventId   String
  userId    Int
  role      String?
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}

model EventTag {
  id        String   @id @default(cuid())
  eventId   String
  label     String
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, label])
}

model EventAttachment {
  id          String   @id @default(cuid())
  eventId     String
  title       String
  description String?
  fileUrl     String
  visible     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model EventLink {
  id        String   @id @default(cuid())
  eventId   String
  label     String
  url       String
  visible   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model EventHighlight {
  id         String             @id @default(cuid())
  eventId    String
  type       EventHighlightType
  title      String
  playerName String
  playerId   Int?
  visible    Boolean            @default(true)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  event  Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  player User? @relation("EventHighlightPlayer", fields: [playerId], references: [id], onDelete: SetNull)
}

model EventRankingEntry {
  id         String   @id @default(cuid())
  eventId    String
  position   Int
  playerName String
  playerId   Int?
  score      String?
  visible    Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  event  Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  player User? @relation("EventRankingPlayer", fields: [playerId], references: [id], onDelete: SetNull)

  @@unique([eventId, position])
}

model EventRegistration {
  id           String                  @id @default(cuid())
  eventId      String
  userId       Int?
  playerName   String
  factionLabel String?
  status       EventRegistrationStatus @default(INSCRITO)
  source       EventRegistrationSource @default(WEB)
  listData     Json?
  notes        String?                 @db.Text
  registeredAt DateTime                @default(now())
  reviewedAt   DateTime?
  reviewedById Int?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  event      Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user       User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  reviewedBy User? @relation("EventRegistrationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([eventId, userId])
  @@index([eventId, status])
  @@index([userId])
}

model CompetitiveMatch {
  id             String               @id @default(cuid())
  eventId        String?
  gameId         String?
  kind           CompetitiveMatchKind @default(CASUAL)
  playedAt       DateTime
  roundNumber    Int?
  sourceReportId String?              @unique
  notes          String?              @db.Text
  createdById    Int?
  validatedById  Int?
  validatedAt    DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  event        Event?                   @relation(fields: [eventId], references: [id], onDelete: SetNull)
  game         Game?                    @relation(fields: [gameId], references: [id], onDelete: SetNull)
  sourceReport CompetitiveMatchReport?  @relation("ApprovedCompetitiveMatchReport", fields: [sourceReportId], references: [id], onDelete: SetNull)
  createdBy    User?                    @relation("CompetitiveMatchCreator", fields: [createdById], references: [id], onDelete: SetNull)
  validatedBy  User?                    @relation("CompetitiveMatchValidator", fields: [validatedById], references: [id], onDelete: SetNull)
  players      CompetitiveMatchPlayer[]

  @@index([eventId, kind, playedAt])
  @@index([gameId, playedAt])
  @@index([playedAt])
}

model CompetitiveMatchPlayer {
  id               String                  @id @default(cuid())
  matchId          String
  userId           Int?
  participantOrder Int
  displayName      String
  factionLabel     String
  outcome          CompetitiveMatchOutcome
  score            Int
  createdAt        DateTime                @default(now())

  match CompetitiveMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user  User?            @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([matchId, participantOrder])
  @@index([userId])
  @@index([matchId, outcome])
}

model CompetitiveMatchReport {
  id                  String                        @id @default(cuid())
  eventId             String?
  gameId              String?
  kind                CompetitiveMatchKind          @default(CASUAL)
  playedAt            DateTime
  roundNumber         Int?
  channel             CompetitiveMatchReportChannel @default(WEB)
  status              CompetitiveMatchReportStatus  @default(PENDING)
  submittedById       Int?
  externalSubmitterId String?
  externalMessageId   String?
  notes               String?                       @db.Text
  rejectionReason     String?                       @db.Text
  reviewedById        Int?
  reviewedAt          DateTime?
  approvedMatch       CompetitiveMatch?             @relation("ApprovedCompetitiveMatchReport")
  createdAt           DateTime                      @default(now())
  updatedAt           DateTime                      @updatedAt

  event       Event?                         @relation(fields: [eventId], references: [id], onDelete: SetNull)
  game        Game?                          @relation(fields: [gameId], references: [id], onDelete: SetNull)
  submittedBy User?                          @relation("CompetitiveMatchReportSubmitter", fields: [submittedById], references: [id], onDelete: SetNull)
  reviewedBy  User?                          @relation("CompetitiveMatchReportReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  players     CompetitiveMatchReportPlayer[]

  @@unique([channel, externalMessageId])
  @@index([eventId, status])
  @@index([status, createdAt])
  @@index([submittedById])
}

model CompetitiveMatchReportPlayer {
  id               String                  @id @default(cuid())
  reportId         String
  userId           Int?
  participantOrder Int
  displayName      String
  factionLabel     String
  outcome          CompetitiveMatchOutcome
  score            Int
  createdAt        DateTime                @default(now())

  report CompetitiveMatchReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  user   User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([reportId, participantOrder])
  @@index([userId])
}

model EventChronicle {
  id        String   @id @default(cuid())
  eventId   String
  articleId String
  label     String?
  position  Int      @default(0)
  featured  Boolean  @default(false)
  createdAt DateTime @default(now())

  event   Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  article NewsArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([eventId, articleId])
  @@index([eventId, position])
  @@index([articleId])
}

model SiteContent {
  key       String   @id
  content   Json
  updatedAt DateTime @updatedAt
}

model UserInvite {
  id          String    @id @default(cuid())
  email       String
  token       String    @unique
  role        Rol       @default(SOCIO)
  createdById Int?
  createdBy   User?     @relation("UserInviteCreator", fields: [createdById], references: [id], onDelete: SetNull)
  usedById    Int?
  usedBy      User?     @relation("UserInviteTarget", fields: [usedById], references: [id], onDelete: SetNull)
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  usedAt      DateTime?

  @@index([email])
  @@index([createdAt])
}
